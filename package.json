{
  "name": "planet",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @planet/web dev",
    "dev:preview": "pnpm --filter @planet/preview dev",
    "dev:preview-static": "pnpm --filter @planet/preview dev:static",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "deploy": "pnpm --filter @planet/web deploy",
    "lint": "oxlint",
    "format": "oxfmt --write ."
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0"
  },
  "packageManager": "pnpm@11.11.0"
}
